{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobius-muse/brand/schemas/content-item.schema.json",
  "title": "Content item (one YAML file per item)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_id",
    "format",
    "campaign",
    "platforms",
    "audience",
    "objective",
    "hook",
    "script",
    "caption",
    "cta",
    "visual_brief",
    "claims",
    "sources",
    "scores",
    "status",
    "rejection_reason",
    "published_urls",
    "performance"
  ],
  "properties": {
    "content_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}-FMT0[123]-[A-Z0-9][A-Z0-9-]*$",
      "description": "e.g. 2026-W43-FMT01-EP03 or 2026-W43-FMT01-EP03-TT"
    },
    "format": {
      "type": "string",
      "enum": [
        "FMT-01",
        "FMT-02",
        "FMT-03"
      ]
    },
    "campaign": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "theme": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "default": null,
      "description": "Optional theme slug used by the Growth Analyst; defaults to campaign."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "youtube",
          "tiktok",
          "instagram",
          "facebook",
          "shorts"
        ]
      }
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,49}$"
      }
    },
    "objective": {
      "type": "string",
      "enum": [
        "brand_trust",
        "brand_recognition",
        "demand",
        "revenue_intent"
      ]
    },
    "hook": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400
    },
    "script": {
      "type": "string",
      "minLength": 20
    },
    "caption": {
      "type": "string",
      "minLength": 3
    },
    "cta": {
      "type": "string",
      "minLength": 3
    },
    "visual_brief": {
      "type": "string",
      "minLength": 3
    },
    "title_options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "thumbnail_brief": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-[0-9]{3,4}$"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 3
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "ref"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hook_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "specificity_evidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "brand_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "platform_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "composite": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "published"
      ]
    },
    "rejection_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "VOICE",
        "UNVERIFIED_CLAIM",
        "OFF_BRAND",
        "WEAK_HOOK",
        "WRONG_AUDIENCE",
        "TOO_GENERIC",
        "PERSONAL",
        null
      ]
    },
    "rejection_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_urls": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Raw platform-supplied metrics only; unknown stays unknown."
    },
    "deriv_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-W[0-9]{2}-FMT0[123]-[A-Z0-9][A-Z0-9-]*$",
      "default": null,
      "description": "Hero content_id when this item is a derivative (atomization rule)."
    },
    "week": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "in_review",
              "approved",
              "published"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "scores"
        ],
        "properties": {
          "scores": {
            "required": [
              "hook_strength",
              "specificity_evidence",
              "clarity",
              "brand_fit",
              "platform_fit",
              "composite"
            ]
          },
          "claims": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "scores"
        ],
        "properties": {
          "scores": {
            "required": [
              "hook_strength",
              "specificity_evidence",
              "clarity",
              "brand_fit",
              "platform_fit",
              "composite"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "rejection_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "published_urls": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "draft"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "rejection_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
