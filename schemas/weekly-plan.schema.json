{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobius-muse/brand/schemas/weekly-plan.schema.json",
  "title": "Strategist output — weekly plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_by", "week", "summary_5_lines", "hero", "supporting", "supporting_only"],
  "properties": {
    "generated_by": { "type": "string", "const": "strategist" },
    "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "summary_5_lines": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 3, "maxLength": 200 }
    },
    "hero": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "working_title", "angle", "audiences", "derivatives", "claims", "theme"],
          "properties": {
            "format": { "type": "string", "enum": ["FMT-01", "FMT-02", "FMT-03"] },
            "working_title": { "type": "string", "minLength": 5, "maxLength": 140 },
            "angle": { "type": "string", "minLength": 20 },
            "audiences": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "derivatives": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["platform", "native_form"],
                "properties": {
                  "platform": { "type": "string", "enum": ["youtube", "tiktok", "instagram", "facebook", "shorts"] },
                  "native_form": { "type": "string", "minLength": 3 }
                }
              }
            },
            "claims": { "type": "array", "items": { "type": "string", "pattern": "^CLM-[0-9]{3,4}$" } },
            "theme": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }
          }
        }
      ]
    },
    "supporting": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "working_title", "angle", "platforms", "claims"],
        "properties": {
          "format": { "type": "string", "enum": ["FMT-01", "FMT-02", "FMT-03"] },
          "working_title": { "type": "string", "minLength": 5, "maxLength": 140 },
          "angle": { "type": "string", "minLength": 20 },
          "platforms": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["youtube", "tiktok", "instagram", "facebook", "shorts"] } },
          "claims": { "type": "array", "items": { "type": "string", "pattern": "^CLM-[0-9]{3,4}$" } }
        }
      }
    },
    "supporting_only": { "type": "boolean" },
    "supporting_only_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "supporting_only": { "const": true } }, "required": ["supporting_only"] },
      "then": {
        "properties": { "hero": { "type": "null" } },
        "required": ["supporting_only_reason"]
      }
    },
    {
      "if": { "properties": { "supporting_only": { "const": false } }, "required": ["supporting_only"] },
      "then": { "properties": { "hero": { "type": "object" } } }
    }
  ]
}
